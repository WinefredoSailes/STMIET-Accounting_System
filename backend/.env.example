# Copy to .env and fill in. NEVER commit .env.
DEBUG=True
SECRET_KEY=change-me-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite dev fallback (zero config). Switch to PostgreSQL for prod:
#   postgres://user:password@localhost:5432/stmiet_accounting
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=60

# Celery / Redis (ADR-010 async jobs); falls back to eager tasks in tests.
REDIS_URL=redis://localhost:6379/0

# Domain constants (ADR-013 / ADR-033).
CYCLE_START_DAY=1        # 0=Mon..6=Sun -> 1=Tue
CYCLE_END_DAY=0          # 0=Mon
JE_APPROVAL_THRESHOLD=100000.00
PCF_REPLENISH_TRIGGER=0.85